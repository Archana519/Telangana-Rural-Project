# Keep text files byte-identical on every computer, so the SHA-256 checks in the pipeline never fail
# because Windows turned line endings into CRLF.
*.py   text eol=lf
*.sh   text eol=lf
*.md   text eol=lf
*.csv  text eol=lf
*.txt  text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.tex  text eol=lf
*.bib  text eol=lf
*.ini  text eol=lf
*.png  binary
*.jpg  binary
*.gpkg binary
*.tif  binary
*.pdf  binary
*.docx binary
*.xlsx binary

# Stage B deliverables are frozen: never convert their line endings.
DELIVERABLES_DAMARAKUNTA_STAGE_B/** -text
